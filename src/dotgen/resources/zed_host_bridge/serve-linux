#!/usr/bin/env bash
set -euo pipefail

node_bin="$HOME/.local/share/fnm/aliases/default/bin/node"
bridge="$HOME/.local/libexec/dotgen/zed-host-bridge.mjs"
config_root="${XDG_CONFIG_HOME:-$HOME/.config}"
cache_root="${XDG_CACHE_HOME:-$HOME/.cache}"
config="$config_root/dotgen/zed-host-bridge.json"
socket="$cache_root/dotgen/zed-host-bridge.sock"

for directory in "$HOME" "$HOME/.local" "$HOME/.local/libexec" "$HOME/.local/libexec/dotgen" "$config_root" "$config_root/dotgen" "$cache_root" "$cache_root/dotgen"; do
  if [ -L "$directory" ] || [ ! -d "$directory" ] || [ ! -O "$directory" ]; then
    printf 'zed-host-bridge: unsafe managed directory: %s\n' "$directory" >&2
    exit 1
  fi
done
if [ ! -x "$node_bin" ] || [ -L "$bridge" ] || [ ! -f "$bridge" ] || [ ! -O "$bridge" ]; then
  printf 'zed-host-bridge: managed runtime or receiver is missing or unsafe\n' >&2
  exit 1
fi
if [ -L "$config" ] || [ ! -f "$config" ] || [ ! -O "$config" ]; then
  printf 'zed-host-bridge: receiver configuration is missing or unsafe: %s\n' "$config" >&2
  exit 1
fi

export ZED_HOST_BRIDGE_CONFIG="${ZED_HOST_BRIDGE_CONFIG:-$config}"
export ZED_HOST_BRIDGE_SOCKET="${ZED_HOST_BRIDGE_SOCKET:-$socket}"
exec "$node_bin" "$bridge" serve
