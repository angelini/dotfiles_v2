{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/serena-reminder.sh",
            "type": "command"
          }
        ]
      }
    ]
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "defaultMode": "auto"
  },
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "light",
  "tui": "fullscreen"
}
